# ============================================
# CONFIGURACIÓN DE SEGURIDAD - PLANTILLA .env
# ============================================
# Copia este archivo a .env y completa con tus valores
# NUNCA commits .env a Git (está en .gitignore)

# Flask
SECRET_KEY=tu_clave_secreta_muy_larga_aqui_cambiar_siempre
FLASK_ENV=production

# Base de Datos MySQL
DB_HOST=localhost
DB_USER=flaskuser
DB_PASSWORD=tu_contraseña_mysql_aqui
DB_NAME=login_db

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu_client_id_de_google_aqui.apps.googleusercontent.com

# Email (Gmail)
EMAIL_SENDER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail_aqui

# Host de la aplicación
APP_HOST=http://localhost:5000

# Nota: Para EMAIL_PASSWORD en Gmail, usar "App Password" (no contraseña normal)
# Ver: https://support.google.com/accounts/answer/185833
